nst max = scroller.scrollWidth - scroller.clientWidth;\n            wrap.classList.toggle('scrollable', max > 4);\n            wrap.classList.toggle('at-end', scroller.scrollLeft >= max - 4);\n          };\n          if (!scroller.dataset.cueBound) {\n            scroller.dataset.cueBound = '1';\n            scroller.addEventListener('scroll', update, { passive: true });\n            if (cue) cue.addEventListener('click', () => scroller.scrollBy({ left: scroller.clientWidth * 0.8, behavior: 'smooth' }));\n            if (window.ResizeObserver) new ResizeObserver(update).observe(scroller);\n            window.addEventListener('resize', update);\n          }\n          update();\n        });\n      };\n      requestAnimationFrame(() => { initScroll(); setTimeout(initScroll, 300); });\n      this._root = el;\n      if (!el.dataset.pickBound) {\n        el.dataset.pickBound = '1';\n        el.addEventListener('click', ev => {\n          const hash = ev.target.closest('a[href^=\"#\"]');\n          if (hash) {\n            ev.preventDefault();\n            const dest = document.getElementById(hash.getAttribute('href').slice(1));\n            if (dest) window.scrollTo({ top: dest.getBoundingClientRect().top + window.scrollY - 16, behavior: 'smooth' });\n            return;\n          }\n          if (ev.target.closest('button, a, image-slot')) return;\n          const t = ev.target.closest('[data-pick]');\n          if (!t) return;\n          const [k, v] = t.dataset.pick.split(':'); const i = +v;\n          this.setState(s => {\n            const cur = { mar: 0, aga: 1, sev: 0, mad: 0, voo: 0, ...(s?.sel || {}) };\n            const next = k === 'mad' && cur[k] === i ? 0 : i;\n            return { sel: { ...cur, [k]: next } };\n          });\n        });\n      }\n      requestAnimationFrame(() => this.syncPicks());\n    };\n    const SA = ['Sujeito à disponibilidade', 'pl'], TWO = ['Até 2 hóspedes', 'pk'], TBC = ['A confirmar na tarifa', 'pl'];\n    const it = (text, t) 